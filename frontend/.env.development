# Biến công khai khi chạy `next dev`.
#
# Nhờ file này mà `npm run dev` chạy được ngay không cần cấu hình gì thêm.
#
# Cố ý để trống phần đo lường: dev không nên bắn sự kiện vào số liệu thật.

# Để trống là cố ý: trình duyệt gọi /api ngay trên origin đang mở trang, Next
# chuyển tiếp xuống backend (xem rewrites trong next.config.ts). Nhờ vậy vào
# site bằng localhost, IP LAN hay cổng nào cũng chạy, và không dính CORS.
# Chỉ điền khi API thật sự nằm ở domain khác.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_FB_PIXEL_ID=
