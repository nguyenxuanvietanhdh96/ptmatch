# Biến công khai cho bản build production.
#
# Next đọc file này khi chạy `next build`. Các giá trị NEXT_PUBLIC_* được nhúng
# thẳng vào bundle gửi tới trình duyệt — chúng KHÔNG phải bí mật (ai mở DevTools
# cũng đọc được), nên để trong repo là hợp lệ.
#
# TUYỆT ĐỐI không đặt secret ở đây (khoá ký JWT, mật khẩu DB, SMTP, OAuth
# secret) — chúng thuộc về .env ở thư mục gốc, chỉ backend đọc lúc chạy.
#
# Đổi giá trị thì phải BUILD LẠI image frontend, restart không đủ.
# Muốn ghi đè tạm cho một lần build: đặt biến cùng tên trong môi trường,
# process.env luôn được ưu tiên hơn file này.

# Để trống = trình duyệt gọi /api cùng origin đang mở trang. Ghi cứng domain
# vào đây thì bản build chỉ chạy đúng ở domain đó — staging, preview hay bản
# xem thử qua IP đều gọi nhầm về ptmatch.vn. Chỉ điền khi API tách hẳn sang
# domain khác (VD: https://api.ptmatch.vn), lúc đó nhớ mở CORS_ORIGINS.
NEXT_PUBLIC_API_URL=

# ----- Đo lường (để trống = không nạp script tương ứng) -----
# Dùng GTM HOẶC GA4 trực tiếp, không dùng cả hai (sẽ đếm hai lần).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_FB_PIXEL_ID=
