# ===== Database =====
POSTGRES_USER=ptmatch
POSTGRES_PASSWORD=ptmatch_secret
POSTGRES_DB=ptmatch
# DATABASE_URL được docker-compose tự ghép; chỉ set khi chạy backend ngoài Docker
# DATABASE_URL=postgresql+asyncpg://ptmatch:ptmatch_secret@localhost:5432/ptmatch

# ===== Redis =====
# REDIS_URL=redis://localhost:6379/0

# ===== Auth =====
# Sinh giá trị thật bằng: openssl rand -hex 32
# Backend TỪ CHỐI khởi động khi ENVIRONMENT=production mà SECRET_KEY vẫn là
# placeholder này hoặc ngắn hơn 32 ký tự (app/core/config.py).
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== App =====
# QUAN TRỌNG khi copy file này thành .env trên server: đổi thành `production`.
# Biến này không chỉ để hiển thị — scripts/backup-db.sh chọn bucket backup theo
# nó (production -> gs://ptmatch-backups-prod). Để nguyên `development` trên
# server nghĩa là backup hằng đêm ghi vào bucket dev không tồn tại và thất bại
# âm thầm. (Backend đọc ENVIRONMENT=production từ docker-compose.prod.yml,
# nhưng script chạy ngoài container thì chỉ thấy file .env này.)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ===== Vùng phục vụ =====
# Tỉnh/thành đang mở, phân tách bằng dấu phẩy. Tên phải khớp danh mục hành chính
# (frontend/public/vn-locations/provinces.json — 34 tỉnh sau sáp nhập 01/07/2025).
#
# Giai đoạn kiểm chứng chỉ mở TP.HCM + Đồng Nai: chợ hai chiều sống bằng mật độ,
# không bằng độ phủ. Hai tỉnh này đã bao trọn Bình Dương, Bà Rịa - Vũng Tàu và
# Bình Phước sau sáp nhập — tổng 263 phường/xã.
#
# ĐỂ RỖNG = bỏ giới hạn, chạy toàn quốc.
#
# Backend từ chối ghi khu vực ngoài danh sách này (422). Frontend có bản sao ở
# frontend/lib/constants.ts để lọc ô chọn — biến NEXT_PUBLIC_* nhúng lúc build
# nên không dùng chung một nguồn được. ĐỔI VÙNG = sửa cả hai chỗ rồi build lại
# image frontend.
SERVED_PROVINCES=Thành phố Hồ Chí Minh,Tỉnh Đồng Nai

# ===== Thông báo lead =====
# Chuỗi kênh dự phòng: gửi theo thứ tự, DỪNG ở kênh đầu tiên thành công.
# Kênh hợp lệ: zalo_oa, zns, email, log
#
# Với thị trường VN, Zalo hiệu quả hơn hẳn email — PT sống trên điện thoại chứ
# không mở hộp thư. Luôn để `log` ở CUỐI làm lưới đỡ: khi mọi kênh thật hỏng,
# dòng log là bằng chứng "có lead nhưng không gửi đi đâu được".
#   Khuyến nghị production:  NOTIFY_CHANNELS=zalo_oa,email,log
#
# Trong lúc chưa có Zalo OA:  NOTIFY_CHANNELS=email,log  — và phải điền SMTP_*
# bên dưới. Để nguyên `log` một mình nghĩa là lead mới chỉ ghi vào log máy chủ,
# PT không nhận được gì; nấc "PT có gọi không" của phễu sẽ bằng 0 vì lý do đó
# chứ không phải vì PT lười. Đây là cấu hình mặc định, KHÔNG dùng được cho bản
# chạy thật.
NOTIFY_CHANNELS=log

# Access token của Zalo Official Account (dùng cho cả zalo_oa lẫn zns).
# LƯU Ý: token có hạn, phải làm mới định kỳ nếu không thông báo sẽ chết lặng.
ZALO_OA_ACCESS_TOKEN=

# ZNS gửi tới SỐ ĐIỆN THOẠI bất kỳ, không cần PT quan tâm OA — nhưng cần OA đã
# xác thực doanh nghiệp và template được Zalo duyệt trước. Bỏ trống thì kênh tự tắt.
ZNS_TEMPLATE_ID=

# Lead còn ở trạng thái 'new' quá số giờ này thì job nhắc sẽ nhắc PT một lần.
# Cron cài sẵn ở scripts/setup-server.sh, chạy mỗi giờ trong khung 7h-21h.
LEAD_REMINDER_AFTER_HOURS=12

# ===== Email (một kênh của NOTIFY_CHANNELS; bỏ trống SMTP_HOST để tắt) =====
#
# DEV: stack có sẵn hộp thư giả Mailpit, không gửi ra ngoài. Đặt:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
#   NOTIFY_CHANNELS=email,log
# rồi xem thư ở http://localhost:8025
#
# PRODUCTION: dùng dịch vụ gửi mail (SendGrid / Mailgun / SES / Brevo), ĐỪNG
# dùng Gmail cá nhân — giới hạn ~500 thư/ngày và dễ bị đánh spam vì nội dung có
# số điện thoại kèm link. Nhớ thêm SPF + DKIM cho tên miền gửi, nếu không thư
# rơi vào hộp rác và PT không bao giờ biết có lead.
#
# Hai kiểu TLS, không trộn được: cổng 587 dùng STARTTLS (SMTP_USE_TLS=true,
# SMTP_USE_SSL=false — mặc định, đúng với Brevo). Cổng 465 dùng TLS ngay từ đầu
# (SMTP_USE_SSL=true) — phổ biến ở một số nhà cung cấp VN. Chọn sai cặp cổng/cờ
# thì treo ~10s rồi lỗi khó hiểu, trông y hệt sai mật khẩu.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PTMatch <no-reply@ptmatch.vn>"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=http://localhost:3000

# ===== OAuth (bỏ trống để tắt provider) =====
# Đăng ký tại: console.cloud.google.com (Google), developers.facebook.com (Facebook), developers.zalo.me (Zalo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:8000/api/auth/zalo/callback

# Provider đã cấu hình nhưng CHƯA muốn hiện nút cho người dùng, phân tách bởi
# dấu phẩy. Dùng khi app phía nhà cung cấp chưa được duyệt công khai:
# credential đã có nên vẫn test được bằng URL trực tiếp, nhưng nút không hiện
# để người lạ khỏi bấm vào rồi bị chính nhà cung cấp từ chối.
#   Ví dụ: app Facebook chưa qua App Review -> OAUTH_HIDDEN_PROVIDERS=facebook
OAUTH_HIDDEN_PROVIDERS=

# ===== Lưu ảnh: local (dev) | gcs (production) =====
#
# Backend TỪ CHỐI khởi động nếu cấu hình dưới đây chắc chắn sẽ vỡ (xem
# app/core/config.py) — sai cấu hình nổ lúc deploy, không phải lúc một PT đang
# tải ảnh hồ sơ lên:
#   - STORAGE_BACKEND=gcs mà GCS_BUCKET_NAME trống  -> chặn
#
# STORAGE_BACKEND=local dùng được cả ở production: docker-compose.prod.yml mount
# volume `media_data` vào /app/media vô điều kiện, nên ảnh sống qua deploy. Đây
# là lựa chọn chính khi tự host một server.
#
# Dev dùng local: ảnh nằm trong Docker volume `media_data`, còn nguyên qua
# restart/rebuild (chỉ mất nếu `docker compose down -v`).
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./media

# BA BIẾN DƯỚI ĐÂY PHẢI CÙNG MỘT MÔI TRƯỜNG.
#
# Trước đây file mẫu ghi bucket dev (ptmatch-media-dev) kèm CDN prod
# (cdn.ptmatch.vn) — copy nguyên lên server là ảnh ghi vào bucket này mà URL trả
# về trỏ host kia, kết quả là mọi ảnh 404. Terraform tạo bucket theo mẫu
# ptmatch-media-<env> và CDN theo mẫu cdn-<env>.ptmatch.vn (prod không có hậu tố).
#
#   dev :  GCP_PROJECT_ID=ptmatch-dev   GCS_BUCKET_NAME=ptmatch-media-dev
#          CDN_BASE_URL=https://cdn-dev.ptmatch.vn
#   prod:  GCP_PROJECT_ID=ptmatch-prod  GCS_BUCKET_NAME=ptmatch-media-prod
#          CDN_BASE_URL=https://cdn.ptmatch.vn
#
# Để trống CDN_BASE_URL thì URL công khai rơi về storage.googleapis.com — chạy
# được, chỉ là không qua CDN.
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
CDN_BASE_URL=

# ===== Frontend =====
# Để trống là đúng: trình duyệt gọi /api cùng origin với trang, Next chuyển
# tiếp xuống backend qua rewrite trong next.config.ts. Chỉ điền khi API nằm ở
# domain riêng (VD: https://api.ptmatch.vn) — điền cổng localhost vào đây là
# cách chắc chắn nhất để site gãy khi mở từ máy khác.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://backend:8000
# Origin công khai, dùng cho sitemap.xml / robots.txt (production: https://ptmatch.vn)
SITE_URL=http://localhost:3000

# ===== Đo lường (GA4 / GTM / Plausible / Facebook Pixel) =====
# KHÔNG đặt ở đây: các biến NEXT_PUBLIC_* sống trong frontend/.env.production
# (và frontend/.env.development), vì Next nhúng chúng vào bundle lúc build.

# Che SĐT lead khi trả về cho PT — bật khi bắt đầu bán gói mở khoá lead
MASK_LEAD_PHONE=false

# ===== Deploy =====
# Nguồn image khi chạy scripts/deploy.sh:
#   pull  — lấy image đã build sẵn từ registry (cần CI đẩy ảnh lên)
#   build — build ngay trên server, cho kịch bản MỘT SERVER không có registry
#           (VPS / Oracle Free Tier). Cần ~2GB RAM trống lúc build Next.js.
DEPLOY_MODE=pull

# ===== Production images (chỉ dùng khi DEPLOY_MODE=pull) =====
# BACKEND_IMAGE=asia-southeast1-docker.pkg.dev/ptmatch-prod/ptmatch/backend:latest
# FRONTEND_IMAGE=asia-southeast1-docker.pkg.dev/ptmatch-prod/ptmatch/frontend:latest
